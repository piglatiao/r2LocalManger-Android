<?xml version="1.0" encoding="utf-8"?>
<!-- 通用：多选勾选圈（未选：描边；选中态由背景色 + 图标表达） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/ink_tertiary" />
    <size
        android:width="22dp"
        android:height="22dp" />
</shape>
