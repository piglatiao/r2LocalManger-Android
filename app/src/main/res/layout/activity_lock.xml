<?xml version="1.0" encoding="utf-8"?>
<!-- 应用锁解锁页（P4-B）：PIN 兜底通道始终可用；生物识别可用时作为优先项。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/appbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_locked_title"
            android:textAppearance="@style/TextAppearance.R2Manager.AppBarTitle" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/outline" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_8">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/lock_locked_title"
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_lock"
                android:tint="@color/brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="@string/lock_locked_title"
                android:textAppearance="@style/TextAppearance.R2Manager.PageTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/lock_unlock_hint"
                android:textAppearance="@style/TextAppearance.R2Manager.ListSubtitle" />

            <!-- PIN 显示 -->
            <TextView
                android:id="@+id/tvPinDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:minHeight="@dimen/space_8"
                android:letterSpacing="0.4"
                android:textAppearance="@style/TextAppearance.R2Manager.PageTitle"
                android:textColor="@color/brand" />

            <!-- 错误 / 倒计时 -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.R2Manager.Caption"
                android:textColor="@color/error"
                android:visibility="gone" />

            <!-- 数字键盘（代码填充） -->
            <GridLayout
                android:id="@+id/keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:columnCount="3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnlock"
                style="@style/Widget.R2Manager.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/lock_unlock" />

            <TextView
                android:id="@+id/tvForgot"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:text="@string/lock_forgot"
                android:textAppearance="@style/TextAppearance.R2Manager.Button"
                android:textColor="@color/brand_2" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
