<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：文件 / 传输 / 设置 三 Tab（ViewPager2 + 自绘底部导航）。P4-A -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/outline" />

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:orientation="horizontal"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/bottom_nav_files"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/bottom_nav_files_icon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_folder"
                android:contentDescription="@string/nav_files" />

            <TextView
                android:id="@+id/bottom_nav_files_label"
                style="@style/TextAppearance.R2Manager.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_files" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_nav_transfer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/bottom_nav_transfer_icon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_swap"
                android:contentDescription="@string/nav_transfer" />

            <TextView
                android:id="@+id/bottom_nav_transfer_label"
                style="@style/TextAppearance.R2Manager.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_transfer" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/bottom_nav_settings_icon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_shield"
                android:contentDescription="@string/nav_settings" />

            <TextView
                android:id="@+id/bottom_nav_settings_label"
                style="@style/TextAppearance.R2Manager.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
