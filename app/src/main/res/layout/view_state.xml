<?xml version="1.0" encoding="utf-8"?>
<!--
  P4-C 公共：五态视图（骨架加载 / 空 / 无结果 / 离线 / 错误）。
  StateView 在代码中按状态切换子视图可见性；文案与动作可由调用方覆盖。
  注意：错误文案一律经 ErrorMapper 取 @string/error_*，页面不自造。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/state_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="@dimen/space_8"
    android:paddingEnd="@dimen/space_8"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8"
    android:clickable="true"
    android:focusable="true">

    <!-- 骨架 / 加载态 -->
    <ProgressBar
        android:id="@+id/state_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 空 / 无结果 / 离线 / 错误态图标（圆角容器背景由代码按状态着色） -->
    <ImageView
        android:id="@+id/state_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:padding="@dimen/space_6"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_info"
        android:contentDescription="@null"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/state_title"
        style="@style/TextAppearance.R2Manager.ListTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:text="@string/state_empty"
        tools:text="此目录暂无文件" />

    <TextView
        android:id="@+id/state_desc"
        style="@style/TextAppearance.R2Manager.ListSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="上传第一个文件，或用其他 App 分享文件到本应用。" />

    <LinearLayout
        android:id="@+id/state_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/state_action_secondary"
            style="@style/Widget.R2Manager.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="重试" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/state_action_primary"
            style="@style/Widget.R2Manager.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:visibility="gone"
            tools:text="去配置" />
    </LinearLayout>
</LinearLayout>
