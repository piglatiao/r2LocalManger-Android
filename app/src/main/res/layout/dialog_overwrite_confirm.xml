<?xml version="1.0" encoding="utf-8"?>
<!-- 覆盖确认对话框内容（R-28）。P4-A -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_6"
    android:paddingEnd="@dimen/space_6"
    android:paddingTop="@dimen/space_6"
    android:paddingBottom="@dimen/space_2">

    <TextView
        android:id="@+id/dialog_overwrite_title"
        style="@style/TextAppearance.R2Manager.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/browser_overwrite_title" />

    <TextView
        android:id="@+id/dialog_overwrite_message"
        style="@style/TextAppearance.R2Manager.ListSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:textColor="@color/ink_secondary" />
</LinearLayout>
